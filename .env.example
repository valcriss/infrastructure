# Copier vers .env et définir un mot de passe fort (ex. : openssl rand -hex 24).
# Utiliser uniquement des caractères alphanumériques (il est intégré à une URL).
POSTGRES_PASSWORD=

# Version des images publiées sur ghcr.io (tag Git, ex. 1.1.1) ; « latest » = dernière version stable.
# Épingler une version en production.
IMAGE_TAG=latest
# Port publié de la console
CONSOLE_PORT=8080

# true uniquement si la console est servie en HTTPS (reverse proxy)
SECURE_COOKIES=false

# Réglage « Affichage » : projets Compose qui font tourner la console et son agent (noms séparés par des virgules).
# Laisser vide si la console est déployée sous le nom de projet par défaut (console-docker, console-docker-agent).
SELF_PROJECTS=

# Clés d'accès (WebAuthn) : connexion avec un téléphone, un ordinateur ou une clé de sécurité
# (YubiKey…), en plus du code à usage unique. Elles servent aussi de deuxième facteur pour le terminal.
# Laisser les deux variables vides pour désactiver les clés d'accès (le code à usage unique
# et les mots de passe continuent de fonctionner).
#
# Il faut renseigner les DEUX variables, d'après l'adresse que vous tapez dans le navigateur.
# Exemple : pour une console ouverte sur https://console.exemple.fr
#   WEBAUTHN_RP_ID=console.exemple.fr
#   WEBAUTHN_ORIGIN=https://console.exemple.fr
#
# WEBAUTHN_RP_ID : le nom de domaine seul, sans « https:// », sans port, sans chemin.
# WEBAUTHN_ORIGIN : l'adresse complète, avec « https:// » et le port s'il y en a un
#                   (ex. https://console.exemple.fr:8443), sans « / » à la fin.
#
# À savoir :
# - HTTPS est obligatoire (sauf pour un essai sur localhost : RP_ID=localhost et
#   ORIGIN=http://localhost:8080, en adaptant le port).
# - Une adresse IP ne convient pas : il faut un nom de domaine.
# - Une seule adresse est prise en compte : si la console est accessible par plusieurs
#   adresses, les clés d'accès ne fonctionneront que sur celle déclarée ici.
# - Choisissez ce domaine avec soin et ne le changez plus : les clés déjà enregistrées
#   cesseraient de fonctionner et chaque utilisateur devrait en ajouter de nouvelles.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Sauvegarde Git : chemin (dans le conteneur) d'une autorité de certification
# supplémentaire, si votre serveur Git utilise une CA interne. Laisser vide sinon.
# Monter le fichier dans le service « console » (volumes) du docker-compose.yml.
GIT_CA_FILE=

# Supervision : collecte des métriques des conteneurs toutes les N secondes (5 à 3600),
# conservées N jours (1 à 365). Plus la période est courte et la rétention longue, plus la base grossit.
METRICS_INTERVAL_SEC=30
METRICS_RETENTION_DAYS=7

# Sécurité des images : version de Trivy (épinglée) et mémoire maximale d'un scan.
# La base de vulnérabilités est conservée dans le volume Docker « console-docker-trivy-cache ».
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:0.76.1
TRIVY_MEMORY=2g
# Taille maximale d'une image scannée (Gio). L'image est exportée dans l'espace de travail de l'agent :
# prévoir sa taille plus quelques Gio libres (voir docs/exploitation.md).
TRIVY_MAX_IMAGE_GB=10

# Registre d'images interne avec une autorité de certification privée : chemin du fichier dans
# le conteneur « console » (à monter via volumes). Laisser vide sinon.
REGISTRY_CA_FILE=

# Exceptions de verification des certificats HTTPS : Git et verification des registres uniquement.
# Liste separee par des virgules : git.interne.example = hote exact ;
# .interne.example = domaine et tous ses sous-domaines. Sans protocole ni port.
# Exemple : TLS_SKIP_VERIFY_HOSTS=.cnavts.fr,git.autre.example
# Vide = verification normale. Preferer GIT_CA_FILE / REGISTRY_CA_FILE.
# Ne configure ni Docker/BuildKit, ni Trivy, ni la connexion agent-console.
TLS_SKIP_VERIFY_HOSTS=

# Projets Compose protégés contre un arrêt ou un redéploiement depuis la console (séparés par des virgules).
# Le projet qui exécute l'agent est toujours protégé.
PROTECTED_PROJECTS=
